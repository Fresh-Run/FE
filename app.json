{
  "expo": {
    "name": "FreshRun",
    "slug": "freshrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshrun",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freshrun.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.freshrun.app",
      "adaptiveIcon": {
        "backgroundColor": "#006e1c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf9fe",
          "dark": {
            "backgroundColor": "#111418"
          }
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "러닝 경로를 지도에 기록하기 위해 위치 정보를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면을 꺼도 러닝 경로를 계속 기록하려면 위치 접근을 '항상 허용'으로 설정해 주세요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "러닝에 사진을 첨부하고 프로필 사진을 설정할 때 사진에 접근해요."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99f17a15-d9ba-4497-adb2-a25a8ac93c61"
      }
    },
    "owner": "freshrun1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99f17a15-d9ba-4497-adb2-a25a8ac93c61"
    }
  }
}