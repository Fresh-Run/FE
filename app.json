{
  "expo": {
    "name": "FreshRun",
    "slug": "freshrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshrun",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freshrun.app"
    },
    "android": {
      "package": "com.freshrun.app",
      "adaptiveIcon": {
        "backgroundColor": "#006e1c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf9fe",
          "dark": {
            "backgroundColor": "#111418"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FreshRun needs your location to map your run route.",
          "locationWhenInUsePermission": "FreshRun needs your location to map your run route."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FreshRun needs photo access so you can attach photos to runs and set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99f17a15-d9ba-4497-adb2-a25a8ac93c61"
      }
    },
    "owner": "freshrun1",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99f17a15-d9ba-4497-adb2-a25a8ac93c61"
    }
  }
}