# Copy this file to .env.local and fill in your Supabase project values.
# Find these at: https://supabase.com/dashboard → your project → Settings → API
#
# IMPORTANT: Only use the anon/public key here. Never put the service_role key in the frontend.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FreshRun backend (FastAPI) — AI route generation.
# NOTE: a physical device can't reach "localhost" — use your machine's LAN IP
# there (e.g. http://192.168.0.10:8000). iOS simulator works with localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
